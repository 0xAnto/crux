{
 "version": 1,
 "spec": "docs/generator_spec.md",
 "note": "Valid cases: expect label, depth, features. Error cases: expect error (the code prefix of one validate() message). Labels and depths are worked out by hand.",
 "cases": [
  {"id": "base_true", "desc": "A positive fact answers the query. Depth 0.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a0", "neg": false},
   "expect": {"label": "True", "depth": 0, "features": []}},

  {"id": "base_true_negated_query", "desc": "The query asks the negative literal of a true fact.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a0", "neg": true},
   "expect": {"label": "False", "depth": 0, "features": []}},

  {"id": "base_false", "desc": "A negative fact (classical negation) gives False.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": false}],
              "rules": [],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a0", "neg": false},
   "expect": {"label": "False", "depth": 0, "features": []}},

  {"id": "base_unknown_open_world", "desc": "No fact and no rule: Unknown (open world). Height of a base attribute is 0.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a1", "value": true}],
              "rules": [],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a0", "neg": false},
   "expect": {"label": "Unknown", "depth": 0, "features": []}},

  {"id": "rule_one_step", "desc": "One rule fires.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": []}},

  {"id": "conj_both_hold", "desc": "A conjunction with two true conditions.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}, {"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["conj"]}},

  {"id": "conj_false_condition_gives_unknown", "desc": "A false condition stops the rule. No rule concludes the negative literal, so the label is Unknown, not False.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": false}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}, {"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["conj"]}},

  {"id": "negated_condition_holds", "desc": "The condition 'not a1' holds because a1 is false.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": false}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}, {"attr": "a1", "neg": true}], "then": {"attr": "a2", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["conj", "neg"]}},

  {"id": "negated_condition_missing_fact_no_naf", "desc": "a1 is unknown, so 'not a1' does not hold (no negation as failure).",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}, {"attr": "a1", "neg": true}], "then": {"attr": "a2", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["conj", "neg"]}},

  {"id": "negative_conclusion", "desc": "A rule concludes a negative literal. A negative conclusion is not the 'neg' feature.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": true}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "False", "depth": 1, "features": []}},

  {"id": "negated_query_on_derived_depth2", "desc": "a2 is derived false at depth 2, so the query 'not a2' is True at depth 2.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": true}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": true},
   "expect": {"label": "True", "depth": 2, "features": []}},

  {"id": "threshold_ge_boundary", "desc": "5 >= 5 holds.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "int", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": 5}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": ">=", "value": 5}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["thr"]}},

  {"id": "threshold_gt_boundary", "desc": "5 > 5 does not hold.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "int", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": 5}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": ">", "value": 5}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["thr"]}},

  {"id": "threshold_lt_boundary", "desc": "3 < 3 does not hold.",
   "theory": {"entities": ["e0", "e1"], "attributes": {"a0": "int", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": 3}, {"entity": "e1", "attr": "a0", "value": 2}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": "<", "value": 3}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["thr"]}},

  {"id": "threshold_lt_below", "desc": "2 < 3 holds. Same theory as threshold_lt_boundary, other entity.",
   "theory": {"entities": ["e0", "e1"], "attributes": {"a0": "int", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": 3}, {"entity": "e1", "attr": "a0", "value": 2}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": "<", "value": 3}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e1", "attr": "a1", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["thr"]}},

  {"id": "threshold_le_boundary", "desc": "3 <= 3 holds.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "int", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": 3}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": "<=", "value": 3}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["thr"]}},

  {"id": "threshold_eq_holds", "desc": "7 == 7 holds. The rule concludes the negative literal.",
   "theory": {"entities": ["e0", "e1"], "attributes": {"a0": "int", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": 7}, {"entity": "e1", "attr": "a0", "value": 8}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": "==", "value": 7}], "then": {"attr": "a1", "neg": true}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "False", "depth": 1, "features": ["thr"]}},

  {"id": "threshold_eq_fails", "desc": "8 == 7 does not hold. Same theory as threshold_eq_holds.",
   "theory": {"entities": ["e0", "e1"], "attributes": {"a0": "int", "a1": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": 7}, {"entity": "e1", "attr": "a0", "value": 8}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": "==", "value": 7}], "then": {"attr": "a1", "neg": true}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e1", "attr": "a1", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["thr"]}},

  {"id": "threshold_missing_value", "desc": "a0 has no value, so 'a0 >= 0' does not hold, although every known value would satisfy it.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "int", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a2", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "op": ">=", "value": 0}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["thr"]}},

  {"id": "chain_depth3", "desc": "A chain of 3 rules.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r2", "if": [{"attr": "a2", "neg": false}], "then": {"attr": "a3", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a3", "neg": false},
   "expect": {"label": "True", "depth": 3, "features": []}},

  {"id": "chain_shortest_proof", "desc": "Two proofs of a3 (depth 3 by r2, depth 2 by r3). The depth is the minimum.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r2", "if": [{"attr": "a2", "neg": false}], "then": {"attr": "a3", "neg": false}}, {"id": "r3", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a3", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a3", "neg": false},
   "expect": {"label": "True", "depth": 2, "features": []}},

  {"id": "chain_max_over_conditions", "desc": "Rule depth is 1 + the maximum depth of its conditions: 1 + max(2, 0) = 3.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r2", "if": [{"attr": "a2", "neg": false}, {"attr": "a0", "neg": false}], "then": {"attr": "a3", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a3", "neg": false},
   "expect": {"label": "True", "depth": 3, "features": ["conj"]}},

  {"id": "chain_unknown_uses_height", "desc": "Unknown: depth = height(a3) = max(1 + h(a2), 1 + h(a1)) = max(3, 2) = 3 (maximum, not minimum).",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool", "a4": "bool"},
              "facts": [{"entity": "e0", "attr": "a4", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r2", "if": [{"attr": "a2", "neg": false}], "then": {"attr": "a3", "neg": false}}, {"id": "r3", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a3", "neg": false}}],
              "exceptions": [], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a3", "neg": false},
   "expect": {"label": "Unknown", "depth": 3, "features": []}},

  {"id": "exception_blocks_rule", "desc": "x0 is active (a2 true), so r0 does not fire. No other rule: Unknown.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a2", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [{"id": "x0", "if": [{"attr": "a2", "neg": false}], "blocks": "r0"}], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["exc"]}},

  {"id": "exception_condition_unknown_does_not_block", "desc": "a2 is unknown, so x0 is not active and r0 fires.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}],
              "exceptions": [{"id": "x0", "if": [{"attr": "a2", "neg": false}], "blocks": "r0"}], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["exc"]}},

  {"id": "exception_on_derived_and_height_ignores_exceptions", "desc": "r1 derives a2, which activates x0 and blocks r0. Unknown: height(a1) = 1 + h(a0) = 1. Exception conditions do not count in the height.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a3", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a1", "neg": false}}, {"id": "r1", "if": [{"attr": "a3", "neg": false}], "then": {"attr": "a2", "neg": false}}],
              "exceptions": [{"id": "x0", "if": [{"attr": "a2", "neg": false}], "blocks": "r0"}], "priorities": []},
   "query": {"type": "binary", "entity": "e0", "attr": "a1", "neg": false},
   "expect": {"label": "Unknown", "depth": 1, "features": ["exc"]}},

  {"id": "priority_negative_wins", "desc": "r0 (a2) and r1 (not a2) both fire. r1 > r0, so a2 is false.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": true}}],
              "exceptions": [], "priorities": [{"higher": "r1", "lower": "r0"}]},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "False", "depth": 1, "features": ["pri"]}},

  {"id": "priority_positive_wins", "desc": "Same as priority_negative_wins with the priority swapped.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": true}}],
              "exceptions": [], "priorities": [{"higher": "r0", "lower": "r1"}]},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["pri"]}},

  {"id": "priority_only_one_side_fires", "desc": "r1 has the higher priority but does not fire (a1 false). r0 gives the value.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": false}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": true}}],
              "exceptions": [], "priorities": [{"higher": "r1", "lower": "r0"}]},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["pri"]}},

  {"id": "exception_blocks_higher_rule", "desc": "x0 blocks the higher rule r1. Only r0 fires: True.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": true}, {"entity": "e0", "attr": "a3", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a2", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a2", "neg": true}}],
              "exceptions": [{"id": "x0", "if": [{"attr": "a3", "neg": false}], "blocks": "r1"}], "priorities": [{"higher": "r1", "lower": "r0"}]},
   "query": {"type": "binary", "entity": "e0", "attr": "a2", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["exc", "pri"]}},

  {"id": "one_rule_beats_all_opponents", "desc": "r0 beats both firing opponents r1 and r2.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": true}, {"entity": "e0", "attr": "a2", "value": true}],
              "rules": [{"id": "r0", "if": [{"attr": "a0", "neg": false}], "then": {"attr": "a3", "neg": false}}, {"id": "r1", "if": [{"attr": "a1", "neg": false}], "then": {"attr": "a3", "neg": true}}, {"id": "r2", "if": [{"attr": "a2", "neg": false}], "then": {"attr": "a3", "neg": true}}],
              "exceptions": [], "priorities": [{"higher": "r0", "lower": "r1"}, {"higher": "r0", "lower": "r2"}]},
   "query": {"type": "binary", "entity": "e0", "attr": "a3", "neg": false},
   "expect": {"label": "True", "depth": 1, "features": ["pri"]}},

  {"id": "depth_counts_only_winning_rules", "desc": "Firing: r0 (a4, depth 1), r2 (a4, depth 3), r1 (not a4, depth 1). r2 > r1 > r0. Only r2 beats all opponents, so the depth is 3, not 1.",
   "theory": {"entities": ["e0"], "attributes": {"a0": "bool", "a1": "bool", "a2": "bool", "a3": "bool", "a4": "bool"},
              "facts": [{"entity": "e0", "attr": "a0", "value": true}, {"entity": "e0", "attr": "a1", "value": true}],
